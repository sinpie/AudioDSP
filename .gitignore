# Publish only the reproducible AudioDSP source releases and documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/diagnostics/
/diagnostics/*
!/diagnostics/refine_tonal_fir.py
!/diagnostics/run_full_option_matrix.py
!/diagnostics/build_option_validation_sequence.py
!/diagnostics/analyze_option_validation.py
!/diagnostics/capture_option_validation.py
!/diagnostics/merge_option_matrix.py
!/diagnostics/validate_live_apply_restore.py
!/AUDIODSP_REPRODUCTION_DOCS/
!/AUDIODSP_REPRODUCTION_DOCS/**
!/releases/
/releases/*
!/releases/audiodsp-pi2-v1.2.0/
!/releases/audiodsp-pi2-v1.2.0/**
!/releases/audiodsp-pi4-pi5-v1.2.0/
!/releases/audiodsp-pi4-pi5-v1.2.0/**

# Credentials and machine-local state
**/*_ed25519
**/*_ed25519.pub
**/*.log
**/pretest-backups/

# Downloaded OS/runtime artifacts
**/*.img
**/*.img.xz
**/*.tar.gz
**/payload/camilladsp

# Generated/cache/reference artifacts
**/__pycache__/
**/*.py[cod]
**/legacy-v1-reference/
