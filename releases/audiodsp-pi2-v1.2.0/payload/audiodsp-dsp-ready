#!/bin/bash
set -euo pipefail

prompt=/usr/local/share/audiodsp/announce_dsp_ready_48k_front_lr.wav
test -f "$prompt"

# camilladsp.service is Type=simple, so its active state can precede ALSA
# playback preparation by a fraction of a second. Wait until the process has
# stayed alive long enough for the U7/dmix path to be ready.
for attempt in $(seq 1 60); do
    if systemctl is-active --quiet camilladsp.service && pgrep -x camilladsp >/dev/null; then
        sleep 1
        if systemctl is-active --quiet camilladsp.service && pgrep -x camilladsp >/dev/null; then
            exec aplay -q -D audiodsp_announce "$prompt"
        fi
    fi
    sleep 1
done

echo "CamillaDSP did not become ready within 60 seconds." >&2
exit 1
