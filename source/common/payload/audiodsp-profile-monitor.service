[Unit]
Description=AudioDSP Xonar U7 Speaker/Headphone Profile Monitor
After=camilladsp.service
Wants=camilladsp.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/audiodsp-profile-monitor.py
Restart=always
RestartSec=2
User=root
Group=root

[Install]
WantedBy=multi-user.target
